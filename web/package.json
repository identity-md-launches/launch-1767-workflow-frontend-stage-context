{
  "name": "veterans-mine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/export.mjs",
    "preview": "vite preview",
    "verify": "node scripts/verify.mjs",
    "test": "node --import tsx --test tests/core.test.ts",
    "test:browser": "node tests/browser.mjs",
    "check:chain": "node scripts/check-chain.mjs"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "4.4.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tanstack/react-query": "5.104.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.7",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
